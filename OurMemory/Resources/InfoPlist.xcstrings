    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера патрэбна, каб сканаваць QR-коды на пахаваннях."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to scan QR codes on graves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера нужна, чтобы сканировать QR-коды на захоронениях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要使用相机扫描墓地上的二维码。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Геапазіцыя патрэбна, каб паказаць вас на карце мемарыяла."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used to show you on the memorial map."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Геопозиция нужна, чтобы показать вас на карте мемориала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要使用您的位置，以便在纪念地地图上显示您。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ да фота патрэбны, каб дадаць сямейныя фотаздымкі."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access is used to attach family photos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к фото нужен, чтобы приложить семейные фотографии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要访问照片，以便附上家庭照片。"
          }
        }
      }
    }
  },
  "version": "1.0"
}