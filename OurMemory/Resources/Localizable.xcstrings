    "do_not_publish_whole_rules_file_msg": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не публікуйце файлы правілаў з праекта цалкам: база агульная з іншымі праграмамі, і іх правілы сатруцца. Змяняйце толькі вузел OurMemory."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't publish the rules files from the project as a whole: the database is shared with other apps, and their rules would be erased. Edit only the OurMemory node."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не публикуйте файлы правил из проекта целиком: база общая с другими приложениями, и их правила сотрутся. Правьте только узел OurMemory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要整体发布项目中的规则文件：数据库与其他应用共用，它们的规则会被清除。只修改 OurMemory 节点。"
          }
        }
      }
    },
