    "tour": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Экскурсія"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tour"
          }
        },
        "ru": {
          "stringUnit": {
