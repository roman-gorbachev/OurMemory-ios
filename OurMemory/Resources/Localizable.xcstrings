    "share_materials_msg": {
      "extractionState": "manual",
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі ў вас ёсць фотаздымкі, дакументы або ўспаміны пра гэтага чалавека, дашліце іх. Пасля праверкі мы дададзім матэрыялы ў картку ветэрана."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have photos, documents or memories of this person, please send them. After review we will add them to the veteran's card."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у вас есть фотографии, документы или воспоминания об этом человеке, пришлите их. После проверки мы добавим материалы в карточку ветерана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您有关于此人的照片、文件或回忆，请发送给我们。审核后我们会将其添加到老兵的卡片中。"
          }
        }
      }
    },
